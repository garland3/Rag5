MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/rag5
MONGODB_DB_NAME=rag5
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# Set DEBUG=true to bypass reverse-proxy auth and use TESTUSER instead
DEBUG=false
TESTUSER=bob@test.com
# Header name injected by the reverse proxy containing the authenticated username
PROXY_USER_HEADER=x-forwarded-user
